# Copy to .env and adjust. .env is gitignored; this example file is committed.
APP_NAME="AI Support Platform"
CLASSIFIER_PATH=models/ticket_classifier.joblib
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support_platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
LOW_CONFIDENCE_THRESHOLD=0.55
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-this-with-a-random-value-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
INFERENCE_RATE_LIMIT_PER_MINUTE=60
INGESTION_RATE_LIMIT_PER_MINUTE=20
MAX_DOCUMENT_BYTES=5000000
MAX_DOCUMENT_PAGES=300
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=100
MAX_SEARCH_RESULTS=20
