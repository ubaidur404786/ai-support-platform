# Copy to .env and adjust. .env is gitignored; this example file is committed.
APP_NAME="AI Support Platform"
CLASSIFIER_PATH=models/ticket_classifier.joblib
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support_platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
LOW_CONFIDENCE_THRESHOLD=0.55
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200